{
  "name": "workflow-telemetry-action",
  "version": "2.0.0",
  "description": "Github action to collect metrics (CPU, memory, I/O, etc ...) from your workflows to help you debug and optimize your CI/CD pipeline",
  "main": "lib/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "package:main": "bun build --bundle src/main.ts --outdir dist/main --target node --sourcemap=linked --entry-naming '[dir]/index.[ext]'",
    "package:post": "bun build --bundle src/post.ts --outdir dist/post --target node --sourcemap=linked --entry-naming '[dir]/index.[ext]'",
    "package:statCollector": "bun build --bundle src/statCollector.ts --outdir dist/sc --target node --sourcemap=linked --entry-naming '[dir]/index.[ext]'",
    "package:statCollectorWorker": "bun build --bundle src/statCollectorWorker.ts --outdir dist/scw --target node --sourcemap=linked --entry-naming '[dir]/index.[ext]'",
    "package": "bun run package:main && bun run package:post && bun run package:statCollector && bun run package:statCollectorWorker",
    "test": "echo \"Warn: no test specified\" && exit 0",
    "all": "bun run format-check && bun run lint && bun run build && bun run package && bun run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runforesight/workflow-telemetry-action.git"
  },
  "keywords": [
    "monitoring",
    "observability",
    "telemetry",
    "github",
    "actions",
    "workflow",
    "ci-cd"
  ],
  "author": "Serkan Özal <serkan@thundra.io>",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/exec": "^1.1.0",
    "@actions/github": "^5.1.1",
    "@octokit/action": "^4.0.9",
    "@octokit/openapi-types": "^14.0.0",
    "axios": "^1.1.2",
    "sprintf-js": "^1.1.2",
    "systeminformation": "^5.11.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/sprintf-js": "^1.1.2",
    "@typescript-eslint/eslint-plugin": "^5.40.0",
    "@typescript-eslint/parser": "^5.40.0",
    "eslint": "^8.25.0",
    "eslint-plugin-github": "^4.1.1",
    "eslint-plugin-prettier": "^5.1.3",
    "js-yaml": "^4.1.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  }
}
