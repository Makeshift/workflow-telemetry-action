  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.0",
    "@actions/tool-cache": "^4.0.0",
    "@octokit/action": "^7.0.0",
    "@octokit/openapi-types": "^24.0.0",
    "axios": "^1.15.2",
    "glob": "^11.0.0",
    "source-map-support": "^0.5.21",
    "sprintf-js": "^1.1.3",
    "systeminformation": "^5.31.5"
  },
  "devDependencies": {
    "@makeshift27015/eslint-config": "^2.1.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^24.0.0",
    "@types/sprintf-js": "^1.1.4",
    "js-yaml": "^4.1.0",
    "typescript": "^5.9.3"
  }
